// Defaults are the HG001 (Garvan) runs. Other genomes override these with a
// parameter file, e.g. -params-file config/params/HG002.yaml
params {
    genome      = 'HG001'
    samplesheet = 'config/samplesheet.csv'
    ref         = 'data/reference/hs37d5.fa'
    sdf         = 'data/reference/hs37d5.sdf'
    capture     = 'data/raw/nexterarapidcapture_expandedexome_targetedregions.bed.gz'
    targets     = 'data/panels/panel_targets.bed'
    evaluable   = 'data/panels/panel_evaluable.bed'
    truth_vcf   = 'data/truth/HG001_GRCh37_1_22_v4.2.1_benchmark.vcf.gz'
    truth_bed   = 'data/truth/HG001_GRCh37_1_22_v4.2.1_benchmark.bed'
    outdir      = 'results'
    min_depth   = 20
    // e.g. '20,30,50' also calls each sample downsampled to these mean depths
    downsample  = ''
    // within-run: same library run twice; between-library: rep_a vs lib_b
    rep_a       = 'NIST7035_run1'
    rep_b       = 'NIST7035_run2'
    lib_b       = 'NIST7086_run1'
    // image for the docker and apptainer profiles, built from the Dockerfile
    container   = 'ghcr.io/taowis/ngs-panel-validation:1.0.0'
}

conda.enabled = true

profiles {
    local {
        // env built from environment.yml; its path must not contain spaces
        process.conda   = "${System.getenv('CONDA_PREFIX_NGS') ?: '/opt/homebrew/Caskroom/miniconda/base/envs/ngs-panel-validation'}"
        executor.cpus   = 10
        // 16 GB machine: leave room for the OS and other apps
        executor.memory = '9 GB'
    }
    docker {
        conda.enabled     = false
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        conda.enabled        = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    // the small data set in tests/data (tests/README.md); use with local,
    // docker or apptainer, e.g. -profile docker,test
    test {
        params.samplesheet = 'tests/data/samplesheet.csv'
        params.ref         = 'tests/data/ref/hs37d5.fa'
        params.sdf         = 'tests/data/ref/hs37d5.sdf'
        params.capture     = 'tests/data/capture.bed.gz'
        params.targets     = 'tests/data/panel_targets.bed'
        params.evaluable   = 'tests/data/panel_evaluable.bed'
        params.truth_vcf   = 'tests/data/HG001_test_truth.vcf.gz'
        params.truth_bed   = 'tests/data/HG001_test_truth.bed'
        params.outdir      = 'results_test_data'
        executor.cpus      = 4
        executor.memory    = '7 GB'
        process {
            withName: BWA_MEM { cpus = 2; memory = '1 GB' }
            withName: MARKDUP { memory = '2 GB' }
            withName: 'MEAN_DEPTH|COVERAGE' { cpus = 2 }
        }
    }
}

process {
    cpus   = 1
    memory = '2 GB'
    // used only by the docker and apptainer profiles
    container = params.container
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
